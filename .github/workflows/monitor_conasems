name: Monitor CONASEMS — 06h

on:
  schedule:
    - cron: "0 6 * * *"
      timezone: "America/Sao_Paulo"

  workflow_dispatch:

permissions:
  contents: read

jobs:
  monitor:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    env:
      SUPABASE_URL: "https://ndmuexdgukgfmzyoilda.supabase.co"
      SUPABASE_SECRET_KEY: ${{ secrets.SUPABASE_SECRET_KEY }}

    steps:
      - name: Baixar código
        uses: actions/checkout@v6

      - name: Configurar Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.12"

      - name: Instalar dependências
        run: |
          python -m pip install --upgrade pip
          pip install -r monitor_conasems/monitor/requirements.txt

      - name: Buscar publicações do dia anterior
        run: |
          python monitor_conasems/monitor/monitor.py --ontem --fonte conasems

      - name: Sincronizar com Supabase
        run: |
          python monitor_conasems/monitor/sincronizar_supabase.py
